{
  "Vertion block": {
    "prefix": "verb",
    "body": ["//version ${1:1.0} *", "$0", "//version $1 *"],
    "description": "Vertion versioned block (// comment)"
  },
  "Vertion ALL": {
    "prefix": "vera",
    "body": ["//version ALL", "$0", "//version ALL"],
    "description": "Vertion ALL block (// comment)"
  },
  "Vertion EXC": {
    "prefix": "vere",
    "body": ["//version EXC", "$0", "//version EXC"],
    "description": "Vertion EXC block — always excluded (// comment)"
  },
  "Vertion tag-only block": {
    "prefix": "vertt",
    "body": ["//version [${1:tag}]", "$0", "//version [$1]"],
    "description": "Vertion tag-only block — no version, selected by tag (// comment)"
  },
  "Vertion conditional tag block": {
    "prefix": "vertc",
    "body": ["//version [${1:tag}{${2:condition}}]", "$0", "//version [$1{$2}]"],
    "description": "Vertion tag-only block gated by a condition (// comment)"
  },
  "Vertion tagged block": {
    "prefix": "vert",
    "body": ["//version ${1:1.0} [${2:tag}] *", "$0", "//version $1 [$2] *"],
    "description": "Vertion tagged versioned block (// comment)"
  },
  "Vertion range block": {
    "prefix": "verrb",
    "body": ["//version ${1:1.3} ${2:2.0} *", "$0", "//version $1 $2 *"],
    "description": "Vertion range block (// comment)"
  },
  "Vertion inline range": {
    "prefix": "verr",
    "body": ["//version ${1:1.3} ${2:2.0}", "$0"],
    "description": "Vertion inline range — affects next line only (// comment)"
  }
}
