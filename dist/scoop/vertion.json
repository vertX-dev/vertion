{
    "version": "1.0.0",
    "description": "Filter source files by version markers and emit a per-version build tree",
    "homepage": "https://github.com/vertX-dev/vertion",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/vertX-dev/vertion/releases/download/v1.0.0/vertion-v1.0.0-x86_64-pc-windows-msvc.zip",
            "hash": "REPLACE_WITH_SHA256_FROM_THE_RELEASE",
            "extract_dir": "vertion-v1.0.0-x86_64-pc-windows-msvc"
        }
    },
    "bin": "vertion.exe",
    "checkver": {
        "github": "https://github.com/vertX-dev/vertion"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vertX-dev/vertion/releases/download/v$version/vertion-v$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "vertion-v$version-x86_64-pc-windows-msvc"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
